# Analysis and Visualizations
## Code
import pandas as pd
import matplotlib.pyplot as plt

crime = pd.read_csv("data/processed/crime_clean.csv")
service = pd.read_csv("data/processed/311_clean.csv")

import os
os.makedirs("outputs/figures", exist_ok=True)
os.makedirs("outputs/tables", exist_ok=True)

## Top crime types
top_crimes = crime["primary_type"].value_counts().head(10)
top_crimes.to_csv("outputs/tables/top_crime_types.csv")

plt.figure(figsize=(10, 6))
top_crimes.plot(kind="bar")
plt.title("Top 10 Crime Types in Chicago")
plt.xlabel("Crime Type")
plt.ylabel("Count")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.savefig("outputs/figures/top_crime_types.png")
plt.close()

## Top 311 request types
top_requests = service["sr_type"].value_counts().head(10)
top_requests.to_csv("outputs/tables/top_311_request_types.csv")

plt.figure(figsize=(10, 6))
top_requests.plot(kind="bar")
plt.title("Top 10 311 Service Request Types in Chicago")
plt.xlabel("Service Request Type")
plt.ylabel("Count")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.savefig("outputs/figures/top_311_request_types.png")
plt.close()

## Monthly trends
crime["date"] = pd.to_datetime(crime["date"], errors="coerce")
service["created_date"] = pd.to_datetime(service["created_date"], errors="coerce")

crime["month_year"] = crime["date"].dt.to_period("M")
service["month_year"] = service["created_date"].dt.to_period("M")

crime_monthly = crime.groupby("month_year").size()
service_monthly = service.groupby("month_year").size()

monthly_trends = pd.DataFrame({
    "crime_count": crime_monthly,
    "service_request_count": service_monthly
}).fillna(0)

monthly_trends.to_csv("outputs/tables/monthly_trends.csv")

plt.figure(figsize=(10, 6))
monthly_trends.plot()
plt.title("Monthly Trends in Crime and 311 Service Requests")
plt.xlabel("Month")
plt.ylabel("Count")
plt.tight_layout()
plt.savefig("outputs/figures/monthly_trends.png")
plt.close()

## Correlation analysis
crime_pivot = crime.pivot_table(
    index="month_year",
    columns="primary_type",
    aggfunc="size",
    fill_value=0
)

service_pivot = service.pivot_table(
    index="month_year",
    columns="sr_type",
    aggfunc="size",
    fill_value=0
)

combined = crime_pivot.join(service_pivot, how="inner", lsuffix="_crime", rsuffix="_311")

correlation_matrix = combined.corr()
correlation_matrix.to_csv("outputs/tables/correlation_matrix.csv")

## Find strongest correlations between crime and 311 categories
correlations = correlation_matrix.unstack().reset_index()
correlations.columns = ["variable_1", "variable_2", "correlation"]

## Remove self-correlations
correlations = correlations[correlations["variable_1"] != correlations["variable_2"]]

## Sort strongest positive correlations
top_correlations = correlations.sort_values(by="correlation", ascending=False).head(20)
top_correlations.to_csv("outputs/tables/top_correlations.csv", index=False)

print("Analysis complete. Outputs saved to outputs/figures and outputs/tables.")
